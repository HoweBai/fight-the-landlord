{
  "name": "@fight-the-landlord/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "斗地主客户端（uni-app，多端）。哑终端：只依赖 @fight-the-landlord/protocol，不含任何游戏规则（2026-10-12 裁决：出牌提示可从 protocol 导入 parseHand/canBeat/HandType 做枚举自检，但禁本地实现规则）。",
  "scripts": {
    "dev": "uni",
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:app": "uni -p app",
    "build": "vue-tsc --noEmit && uni build",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:app": "uni build -p app",
    "preview": "vite preview --outDir dist/build/h5",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020620260914001",
    "@fight-the-landlord/protocol": "workspace:*",
    "pinia": "^2.2.6",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.13",
    "wot-design-uni": "1.14.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020620260914001",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "engine.io-client": "6.6.6",
    "jsdom": "^25.0.1",
    "sass": "1.79.6",
    "typescript": "^5.7.0",
    "vite": "5.4.21",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
