        "overrides": []
      },
      "gridPos": { "h": 6, "w": 16, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
          "expr": "up",
          "instant": true,
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "服务 up 矩阵（13 目标）",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
          "expr": "sum by (job) (rate(http_requests_total[5m]))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "RPS（按 job）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
          "expr": "sum by (job) (rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum by (job) (rate(http_requests_total[5m])), 1e-9)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "5xx 率（按 job；告警线 5% / 20%）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "p95 请求延迟（按 job）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
          "expr": "ws_connections",
          "legendFormat": "ws_connections",
          "refId": "A"
        }
      ],
      "title": "WS 连接数（告警线 4000 / 8000）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU 使用率",
          "refId": "A"
        }
      ],
      "title": "主机 CPU 使用率",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "可用内存",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "已用内存",
          "refId": "B"
        }
      ],
      "title": "主机内存（告警线：可用 < 800 MiB）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ftl-prometheus" },
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\",mountpoint=\"/\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\",mountpoint=\"/\"}",
          "legendFormat": "根分区可用率",
          "refId": "A"
        }
      ],
      "title": "根分区可用率（告警线 20% / 10%）",
      "type": "timeseries"
    }
  ],
