{
  "name": "@fight-the-landlord/user-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "test": "vitest run",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "migration:run": "typeorm migration:run -d dist/data-source.js",
