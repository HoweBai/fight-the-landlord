    "multi-replica": "node dist/multi-replica-main.js",
    "ws-load": "node dist/ws-load.js",
    "conformance:slice-05": "node dist/run.js slice-05",
    "conformance:slice-06": "node dist/run.js slice-06",
    "conformance:slice-07": "node dist/run.js slice-07",
    "conformance:slice-07.1": "node dist/run.js slice-07.1",
    "conformance:slice-08": "node dist/run.js slice-08",
    "conformance:slice-09": "node dist/run.js slice-09",
    "conformance:slice-10": "node dist/run.js slice-10",
    "conformance:slice-11": "node dist/run.js slice-11",
    "conformance:slice-07.2-security": "node dist/run.js slice-07.2-security",
    "conformance:slice-07.2-boundary": "node dist/run.js slice-07.2-boundary",
    "conformance:slice-07.2-hardening": "node dist/run.js slice-07.2-hardening",
    "conformance:slice-07.2-deploy": "node dist/run.js slice-07.2-deploy",
