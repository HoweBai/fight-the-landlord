    "conformance:slice-07.4-pipeline": "node dist/run.js slice-07.4-pipeline"
  },
  "dependencies": {
    "@fight-the-landlord/protocol": "workspace:*",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@fight-the-landlord/test-utils": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "js-yaml": "4.3.2",
    "typescript": "^5.7.0"
  }
}
