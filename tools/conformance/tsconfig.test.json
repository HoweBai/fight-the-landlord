{
  /**
   * `test/**` 的类型闸（照 `packages/currency-service/tsconfig.test.json` 同形）：
   * 包的 `tsconfig.json` 要 `rootDir: ./src` + `outDir: ./dist` 才能构建 ⇒ `include` 只有
   * `src/**`，测试代码否则不受任何类型闸管辖（vitest 走 esbuild，不做类型检查）。
   *
   * ⚠️ 两个**必须**的覆盖（同 currency 的注释）：
   *  - `module: ESNext` + `moduleResolution: Bundler`：vitest 的真实解析语义；
   *  - `include` 同时含 `src/**` 与 `test/**`：测试引用的 src 符号也要在这把尺子下解析。
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*", "test/**/*"]
}
